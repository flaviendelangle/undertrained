import { Theme, State, Actions, Overlay, NearbyDevice, ProfileStep, WorkoutRow, ChartBin, PlanStep } from "state.slint";
import { DevicePicker, LeaveGuard } from "shared.slint";
import { DesignFlow } from "design_flow.slint";
export { Theme, State, Actions, NearbyDevice, ProfileStep, WorkoutRow, ChartBin, PlanStep }

// The window: it owns nothing but the aliases native code reads and writes; the design in
// design_flow.slint draws the shared state.
//
// Every user-facing string goes through @tr and the bundled catalogs in ui/lang. Rust
// hands over state codes and raw diagnostics; wording lives in the .slint files.
export component AppWindow inherits Window {
    title: "Undertrained Indoor";
    // Embedded at build time; a static texture is what the desktop icon path needs.
    icon: @image-url("../resources/icon.png");
    preferred-width: 1180px;
    preferred-height: 800px;
    // Small enough for a half-screen window beside a video; every design reflows down to it.
    min-width: 500px;
    min-height: 560px;
    background: Theme.background;
    default-font-family: "DejaVu Sans";
    default-font-size: 14px;

    // Native accessors, one per State property. `set_x` and `get_x` in Rust land here and
    // flow into the global the designs read.
    in-out property <int> library-variant <=> State.library-variant;
    in-out property <WorkoutRow> preview-workout <=> State.preview-workout;
    in-out property <bool> preview-free <=> State.preview-free;
    in-out property <bool> previewing <=> State.previewing;
    in-out property <string> language <=> State.language;
    in-out property <bool> logged-in <=> State.logged-in;
    in-out property <string> rider-name <=> State.rider-name;
    in-out property <string> server-origin <=> State.server-origin;
    in-out property <bool> server-configured <=> State.server-configured;
    in-out property <bool> signing-in <=> State.signing-in;
    in-out property <int> auth-notice <=> State.auth-notice;
    in-out property <string> auth-detail <=> State.auth-detail;
    in-out property <int> message-code <=> State.message-code;
    in-out property <string> message-detail <=> State.message-detail;
    in-out property <bool> scanning <=> State.scanning;
    in-out property <bool> picker-open <=> State.picker-open;
    in-out property <int> picker-role <=> State.picker-role;
    in-out property <int> screen <=> State.screen;
    in-out property <[WorkoutRow]> workouts <=> State.workouts;
    in-out property <[WorkoutRow]> built-ins <=> State.built-ins;
    in-out property <int> workouts-total <=> State.workouts-total;
    in-out property <int> workouts-personal <=> State.workouts-personal;
    in-out property <string> workout-query <=> State.workout-query;
    in-out property <bool> workouts-filtering <=> State.workouts-filtering;
    in-out property <bool> workouts-loading <=> State.workouts-loading;
    in-out property <bool> workouts-loaded <=> State.workouts-loaded;
    in-out property <int> workouts-error <=> State.workouts-error;
    in-out property <int> workouts-notice <=> State.workouts-notice;
    in-out property <string> workouts-notice-detail <=> State.workouts-notice-detail;
    in-out property <WorkoutRow> selected-workout <=> State.selected-workout;
    in-out property <int> ride-phase <=> State.ride-phase;
    in-out property <bool> ride-present <=> State.ride-present;
    in-out property <bool> ride-has-workout <=> State.ride-has-workout;
    in-out property <string> ride-name <=> State.ride-name;
    in-out property <string> ride-meta <=> State.ride-meta;
    in-out property <string> ride-summary <=> State.ride-summary;
    in-out property <bool> ride-built-in <=> State.ride-built-in;
    in-out property <[ProfileStep]> ride-profile <=> State.ride-profile;
    in-out property <string> ride-elapsed <=> State.ride-elapsed;
    in-out property <string> ride-paused-for <=> State.ride-paused-for;
    in-out property <string> ride-power <=> State.ride-power;
    in-out property <string> ride-hr <=> State.ride-hr;
    in-out property <string> ride-cadence <=> State.ride-cadence;
    in-out property <bool> ride-power-live <=> State.ride-power-live;
    in-out property <bool> ride-hr-live <=> State.ride-hr-live;
    in-out property <bool> ride-cadence-live <=> State.ride-cadence-live;
    in-out property <float> ride-power-level <=> State.ride-power-level;
    in-out property <float> ride-target-level <=> State.ride-target-level;
    in-out property <float> ride-band-level <=> State.ride-band-level;
    in-out property <int> ride-power-zone <=> State.ride-power-zone;
    in-out property <[ChartBin]> ride-chart <=> State.ride-chart;
    in-out property <int> ride-chart-bins <=> State.ride-chart-bins;
    in-out property <string> ride-chart-top <=> State.ride-chart-top;
    in-out property <string> ride-chart-hr-range <=> State.ride-chart-hr-range;
    in-out property <bool> ride-chart-whole <=> State.ride-chart-whole;
    in-out property <bool> ride-guided <=> State.ride-guided;
    in-out property <bool> ride-test <=> State.ride-test;
    in-out property <[ProfileStep]> ride-plan <=> State.ride-plan;
    in-out property <[PlanStep]> ride-steps <=> State.ride-steps;
    in-out property <int> ride-plan-steps <=> State.ride-plan-steps;
    in-out property <string> ride-plan-total <=> State.ride-plan-total;
    in-out property <float> ride-workout-progress <=> State.ride-workout-progress;
    in-out property <bool> ride-workout-complete <=> State.ride-workout-complete;
    in-out property <string> ride-workout-remaining <=> State.ride-workout-remaining;
    in-out property <int> ride-step-number <=> State.ride-step-number;
    in-out property <float> ride-step-start <=> State.ride-step-start;
    in-out property <float> ride-step-share <=> State.ride-step-share;
    in-out property <string> ride-step-duration <=> State.ride-step-duration;
    in-out property <string> ride-step-target <=> State.ride-step-target;
    in-out property <int> ride-step-role <=> State.ride-step-role;
    in-out property <string> ride-step-note <=> State.ride-step-note;
    in-out property <string> ride-step-remaining <=> State.ride-step-remaining;
    in-out property <int> ride-step-remaining-seconds <=> State.ride-step-remaining-seconds;
    in-out property <float> ride-step-progress <=> State.ride-step-progress;
    in-out property <string> ride-step-cadence <=> State.ride-step-cadence;
    in-out property <bool> ride-cadence-off <=> State.ride-cadence-off;
    in-out property <string> ride-target <=> State.ride-target;
    in-out property <int> ride-target-zone <=> State.ride-target-zone;
    in-out property <string> ride-delta <=> State.ride-delta;
    in-out property <int> ride-delta-state <=> State.ride-delta-state;
    in-out property <string> ride-next-duration <=> State.ride-next-duration;
    in-out property <string> ride-next-target <=> State.ride-next-target;
    in-out property <int> ride-next-zone <=> State.ride-next-zone;
    in-out property <int> ride-next-role <=> State.ride-next-role;
    in-out property <string> ride-bias <=> State.ride-bias;
    in-out property <bool> ride-bias-can-down <=> State.ride-bias-can-down;
    in-out property <bool> ride-bias-can-up <=> State.ride-bias-can-up;
    in-out property <bool> ride-erg-enabled <=> State.ride-erg-enabled;
    in-out property <int> ride-erg-state <=> State.ride-erg-state;
    in-out property <string> ride-erg-watts <=> State.ride-erg-watts;
    out property <bool> ride-erg-available: State.ride-erg-available;
    in-out property <string> ride-avg-power <=> State.ride-avg-power;
    in-out property <string> ride-max-power <=> State.ride-max-power;
    in-out property <string> ride-avg-hr <=> State.ride-avg-hr;
    in-out property <string> ride-max-hr <=> State.ride-max-hr;
    in-out property <string> ride-avg-cadence <=> State.ride-avg-cadence;
    in-out property <int> ride-save-state <=> State.ride-save-state;
    in-out property <string> ride-save-detail <=> State.ride-save-detail;
    in-out property <string> ride-folder <=> State.ride-folder;
    in-out property <int> ride-notice <=> State.ride-notice;
    in-out property <string> ride-notice-detail <=> State.ride-notice-detail;
    in-out property <string> ride-activity-name <=> State.ride-activity-name;
    in-out property <int> ride-upload-state <=> State.ride-upload-state;
    in-out property <int> ride-upload-error <=> State.ride-upload-error;
    in-out property <bool> ride-upload-retry <=> State.ride-upload-retry;
    in-out property <string> ride-upload-detail <=> State.ride-upload-detail;
    in-out property <bool> ride-upload-submitted <=> State.ride-upload-submitted;
    in-out property <int> leave-guard <=> State.leave-guard;
    out property <bool> ride-active: State.ride-active;
    out property <bool> ride-unsaved: State.ride-unsaved;
    out property <bool> ride-uploading: State.ride-uploading;
    out property <bool> ride-saving: State.ride-saving;
    out property <bool> ride-busy: State.ride-busy;
    out property <bool> ride-chip: State.ride-chip;
    out property <bool> any-sensor: State.any-sensor;
    in-out property <bool> session-live <=> State.session-live;
    in-out property <int> bluetooth-state <=> State.bluetooth-state;
    in-out property <int> bluetooth-issue <=> State.bluetooth-issue;
    in-out property <string> bluetooth-detail <=> State.bluetooth-detail;
    in-out property <int> ant-state <=> State.ant-state;
    in-out property <int> ant-issue <=> State.ant-issue;
    in-out property <string> ant-detail <=> State.ant-detail;
    in-out property <[NearbyDevice]> nearby <=> State.nearby;
    in-out property <string> trainer-name <=> State.trainer-name;
    in-out property <string> hr-name <=> State.hr-name;
    in-out property <int> trainer-state <=> State.trainer-state;
    in-out property <int> hr-state <=> State.hr-state;
    in-out property <bool> trainer-ant <=> State.trainer-ant;
    in-out property <bool> hr-ant <=> State.hr-ant;
    in-out property <string> power <=> State.power;
    in-out property <string> cadence <=> State.cadence;
    in-out property <string> heart-rate <=> State.heart-rate;
    in-out property <int> resistance-state <=> State.resistance-state;
    in-out property <bool> setup-saved <=> State.setup-saved;
    in-out property <bool> help-open <=> State.help-open;
    out property <bool> trainer-connected: State.trainer-connected;
    out property <bool> hr-connected: State.hr-connected;
    out property <bool> any-radio: State.any-radio;
    out property <bool> can-start: State.can-start;
    out property <bool> ride-saved: State.ride-saved;
    out property <bool> ride-ready: State.ride-ready;
    out property <bool> erg-toggle-shown: State.erg-toggle-shown;
    out property <bool> step-controls-shown: State.step-controls-shown;
    out property <bool> can-open-ride: State.can-open-ride;

    // A conditional child: the window's own size constraints then never derive from the
    // screens' breakpoints, which Slint would otherwise report as a binding loop.
    if root.visible: DesignFlow { }
    if State.leave-guard != 0: LeaveGuard { }
    if State.picker-open: DevicePicker { }
}
