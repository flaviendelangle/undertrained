# Wording follows the Undertrained website's fr-FR messages: "séance" for a workout,
# "séances intégrées" for the built-in tests, "home trainer" and "capteur cardiaque".
# Personal workout names, device names and raw diagnostics are never translated.

msgid "A sensor radio reported an error."
msgstr "Une radio de capteurs a signalé une erreur."

msgid "ANT+ {}"
msgstr "ANT+ {}"

msgid "Any Bluetooth or ANT+ heart-rate strap, or a watch broadcast."
msgstr "Toute ceinture cardiaque Bluetooth ou ANT+, ou une montre en diffusion."

msgid "BPM"
msgstr "BPM"

msgid "Back to workouts"
msgstr "Retour aux séances"

msgid "Bluetooth FTMS trainers, ANT+ FE-C trainers, or power meters as read-only."
msgstr "Home trainers Bluetooth FTMS ou ANT+ FE-C, ou capteurs de puissance en lecture seule."

msgid "Bluetooth and ANT+ are unavailable"
msgstr "Bluetooth et ANT+ sont indisponibles"

msgid "Bluetooth is switched off or blocked by the system. Turn it on in your system settings, then search again."
msgstr "Le Bluetooth est éteint ou bloqué par le système. Activez-le dans les réglages système, puis relancez la recherche."

msgid "Bluetooth · fair signal · {}"
msgstr "Bluetooth · signal moyen · {}"

msgid "Bluetooth · strong signal · {}"
msgstr "Bluetooth · signal fort · {}"

msgid "Bluetooth · weak signal · {}"
msgstr "Bluetooth · signal faible · {}"

msgid "Bluetooth · {}"
msgstr "Bluetooth · {}"

msgid "Browser links need a signed-in account session."
msgstr "Les liens vers le navigateur nécessitent une session de compte connectée."

msgid "Built-in workouts"
msgstr "Séances intégrées"

msgid "Built-in"
msgstr "Intégrée"

msgid "CADENCE"
msgstr "CADENCE"

