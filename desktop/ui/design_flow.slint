import { ScrollView } from "std-widgets.slint";
import { Theme, State, Actions, Overlay, WorkoutRow } from "state.slint";
import { ActionButton, GlyphButton, Notice, WorkoutChart, PlanBar, Pill, Pulse, Caption, LiveMetric, MetricTile, Page, EmptyPanel, RadioPill, Gauge, Brand, ChartPanel, ZoneDot, StepRow, BuiltInBadge, TextField, BreathingDot } from "widgets.slint";
import { Copy, AuthForm, DeviceMessage, HelpPanel, SensorTile, WorkoutGrid, LibraryState, LibraryNotices, StepList, SensorCheck, RideNotices, ErgToggle, ErgChoice, ErgStatus, IntensityControl, SkipButton, CadenceCue, SummaryStats, SaveStatus, UploadCard, FolderRow } from "shared.slint";

// One guided path, the way Zwift and ROUVY walk a rider in. Devices, workout, ride: three
// numbered steps in the header, one primary action per screen, and a ride screen that
// drops the chrome for a full-window HUD around a power gauge.

// One numbered step of the header. The current step is filled, ridden steps carry a check.
component StepTab inherits Rectangle {
    in property <int> number;
    in property <string> label;
    in property <bool> active;
    in property <bool> done;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback activated();
    width: layout.preferred-width;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    layout := HorizontalLayout {
        spacing: 8px; padding-left: 6px; padding-right: 6px;
        Rectangle {
            y: (parent.height - self.height) / 2; width: 24px; height: 24px; border-radius: 12px;
            background: root.active ? Theme.primary : root.done ? Theme.primary.with-alpha(0.18) : Theme.sunken;
            border-width: root.active || root.done ? 0px : 1px; border-color: Theme.border;
            Text {
                text: root.done && !root.active ? "✓" : root.number;
                color: root.active ? Theme.primary-ink : root.done ? Theme.primary : root.enabled ? Theme.muted : Theme.faint;
                font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if !root.compact || root.active: Text {
            text: root.label; color: root.active ? Theme.ink : root.enabled ? Theme.muted : Theme.faint;
            font-size: 14px; font-weight: 600; vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled && !Overlay.open;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
    Rectangle { y: 12px; height: parent.height - 24px; border-width: focus.has-focus ? 2px : 0px; border-color: Theme.primary; border-radius: 8px; background: transparent; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } }
}

component FlowHeader inherits Rectangle {
    in property <bool> narrow;
    // The chrome compacts (mark alone, current step's label alone, no rider name) well
    // before the pages reflow, so the stepper never crowds Sign out.
    in property <bool> compact;
    height: 64px;
    background: Theme.background;
    HorizontalLayout {
        padding-left: root.narrow ? 16px : 28px; padding-right: root.narrow ? 16px : 28px; spacing: root.narrow ? 10px : 20px;
        Brand { mark-only: root.compact; }
        if State.logged-in: HorizontalLayout {
            spacing: root.compact ? 0px : 4px; alignment: start;
            StepTab { number: 1; label: @tr("Devices"); compact: root.compact; active: State.screen == 0; done: State.trainer-connected; activated => { Actions.navigate(0); } }
            if !root.compact: Text { text: "›"; color: Theme.faint; font-size: 16px; vertical-alignment: center; }
            StepTab { number: 2; label: @tr("Workout"); compact: root.compact; active: State.screen == 1; done: State.ride-present; activated => { Actions.navigate(1); } }
            if !root.compact: Text { text: "›"; color: Theme.faint; font-size: 16px; vertical-alignment: center; }
            StepTab { number: 3; label: @tr("Ride"); compact: root.compact; active: State.screen == 2; done: State.ride-saved; enabled: State.ride-present || State.ride-busy; activated => { Actions.navigate(2); } }
        }
        Rectangle { horizontal-stretch: 1; min-width: 0px; }
        if State.ride-chip: HorizontalLayout {
            spacing: 6px;
            Rectangle { y: (parent.height - self.height) / 2; width: 8px; height: 8px; border-radius: 4px; background: Copy.ride-chip-color(); }
            ActionButton { y: (parent.height - self.height) / 2; label: Copy.ride-chip-label(root.compact); compact: true; activated => { Actions.navigate(2); } }
        }
        if State.logged-in && !root.compact && !State.ride-chip: Text { text: State.rider-name; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; max-width: 160px; }
        if State.logged-in: ActionButton { y: (parent.height - self.height) / 2; label: @tr("Sign out"); quiet: true; compact: true; activated => { Actions.sign-out(); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

component FlowLogin inherits Rectangle {
    in property <bool> narrow;
    ScrollView {
        VerticalLayout {
            alignment: center; padding: root.narrow ? 20px : 40px; spacing: 0px;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(root.width - (root.narrow ? 40px : 80px), 520px); spacing: 18px;
                    Text { text: @tr("Ride inside."); color: Theme.ink; font-size: root.narrow ? 40px : 56px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                    Text {
                        text: @tr("Pair a smart trainer and a heart-rate strap over Bluetooth or ANT+, pick a workout from your Undertrained library, and ride it step by step.");
                        color: Theme.muted; font-size: 15px; wrap: word-wrap; horizontal-alignment: center;
                    }
                    // The interval silhouette, drawn with native rectangles.
                    Rectangle {
                        height: 120px;
                        HorizontalLayout {
                            spacing: 5px;
                            for h in [22, 34, 48, 72, 96, 58, 96, 58, 96, 58, 96, 72, 48, 34]: Rectangle {
                                horizontal-stretch: 1; min-width: 6px;
                                Rectangle { y: parent.height - self.height; width: parent.width; height: parent.height * h / 100; border-radius: 3px; background: h >= 90 ? Theme.primary : Theme.raised; }
                            }
                        }
                    }
                    Rectangle { height: 8px; }
                    AuthForm { centered: true; }
                    Text { text: @tr("Use your Undertrained account. Strava sign-in opens in your browser, and this window picks up the session when you return."); color: Theme.faint; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                    Rectangle { height: 8px; }
                    Caption { text: "FTMS  ·  CYCLING POWER  ·  HEART RATE  ·  ANT+"; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

component FlowPair inherits Rectangle {
    in property <bool> narrow;
    Page { max: 1100px; VerticalLayout {
        padding-top: root.narrow ? 16px : 28px; padding-bottom: 16px; spacing: 16px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 6px; horizontal-stretch: 1; min-width: 0px;
                Text { text: @tr("Pair your devices"); color: Theme.ink; font-size: root.narrow ? 24px : 30px; font-weight: 700; wrap: word-wrap; }
                Text { text: @tr("Pedal a few strokes to wake the trainer, then find it below. Saved devices are marked in the list."); color: Theme.muted; font-size: 13px; wrap: word-wrap; }
            }
            if !root.narrow: VerticalLayout {
                spacing: 4px; alignment: center;
                RadioPill { name: "Bluetooth"; state: State.bluetooth-state; }
                RadioPill { name: "ANT+"; state: State.ant-state; }
            }
        }
        if root.narrow: HorizontalLayout {
            spacing: 16px; alignment: start;
            RadioPill { name: "Bluetooth"; state: State.bluetooth-state; }
            RadioPill { name: "ANT+"; state: State.ant-state; }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 16px; alignment: start; padding-right: 4px;
                if !root.narrow: HorizontalLayout {
                    spacing: 16px;
                    SensorTile { role: 0; horizontal-stretch: 3; }
                    SensorTile { role: 1; horizontal-stretch: 2; }
                }
                if root.narrow: SensorTile { role: 0; }
                if root.narrow: SensorTile { role: 1; }
                if State.help-open: HelpPanel { }
                if State.message-code != 0 && !State.picker-open: DeviceMessage { }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        // The step's one primary action stays pinned at the bottom: save the setup and go on.
        HorizontalLayout {
            spacing: 12px;
            if !root.narrow: VerticalLayout {
                spacing: 3px; alignment: center; horizontal-stretch: 1; min-width: 0px;
                Text {
                    text: State.setup-saved ? @tr("Setup saved.") : State.trainer-connected ? @tr("Trainer connected.") : @tr("Connect a trainer to finish.");
                    color: Theme.ink; font-size: 15px; font-weight: 600; overflow: elide;
                }
                Text {
                    text: State.setup-saved ? @tr("These devices are remembered on this computer.") : @tr("Heart rate is optional. Choices are stored on this computer only.");
                    color: Theme.muted; font-size: 12px; overflow: elide;
                }
            }
            if root.narrow: Rectangle { horizontal-stretch: 1; min-width: 0px; }
            ActionButton { y: (parent.height - self.height) / 2; label: State.help-open ? @tr("Hide help") : @tr("Help"); quiet: true; activated => { State.help-open = !State.help-open; } }
            if !State.trainer-connected: ActionButton { y: (parent.height - self.height) / 2; label: @tr("Skip for now"); quiet: true; activated => { Actions.navigate(1); } }
            if State.trainer-connected: ActionButton {
                y: (parent.height - self.height) / 2;
                label: State.setup-saved ? @tr("Continue") : @tr("Save & continue"); primary: true;
                activated => { if !State.setup-saved { Actions.save-setup(); } if State.setup-saved { Actions.navigate(1); } }
            }
        }
    } }
}

// A filter of the library, as a chip in the toolbar.
component FilterChip inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active;
    callback activated();
    height: 32px; border-radius: 16px;
    preferred-width: layout.preferred-width; min-width: layout.preferred-width;
    background: root.active ? Theme.primary.with-alpha(0.16) : touch.has-hover ? Theme.raised : Theme.sunken;
    border-width: 1px; border-color: root.active ? Theme.primary.with-alpha(0.5) : Theme.border;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.activated(); }
    layout := HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 6px;
        Text { text: root.label; color: root.active ? (Theme.dark ? Theme.primary : Theme.primary.darker(0.1)) : Theme.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        Text { text: root.count; color: root.active ? (Theme.dark ? Theme.primary : Theme.primary.darker(0.1)) : Theme.muted; font-size: 12px; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: !Overlay.open;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
    Rectangle { border-width: focus.has-focus ? 2px : 0px; border-color: Theme.primary; border-radius: root.border-radius; background: transparent; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.activated(); } }
}

// A section's label: small caps with the count, a hairline, an optional note.
component SectionLabel inherits HorizontalLayout {
    in property <string> text;
    in property <int> count;
    in property <string> note: "";
    spacing: 10px; padding-top: 6px;
    Caption { text: root.text + " · " + root.count; vertical-alignment: center; }
    Rectangle { height: 1px; y: (parent.height - self.height) / 2; horizontal-stretch: 1; background: Theme.border; }
    if root.note != "": Text { text: root.note; color: Theme.faint; font-size: 12px; vertical-alignment: center; overflow: elide; max-width: 320px; }
}

// The one thing every row shares: clicking it, or pressing Enter or Space on it, is one
// action, `chosen`; the row decides what that means.
component RowSurface inherits Rectangle {
    in property <string> name;
    in property <bool> enabled: true;
    callback chosen();
    border-radius: 10px;
    background: touch.has-hover && root.enabled ? Theme.raised.with-alpha(Theme.dark ? 0.6 : 1) : Theme.card;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.border;
    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.chosen(); } }
    focus := FocusScope {
        enabled: root.enabled && !Overlay.open;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.chosen(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(); } }
    @children
}

// One wide row per workout. The name leads at 16px with the summary under it, the profile
// is a thumbnail on the left, the duration sits in its own column, and the browser link
// shrinks to a glyph so the row reads as one action: ride this.
component LibraryRow inherits RowSurface {
    in property <WorkoutRow> workout;
    in property <bool> live;
    in property <bool> narrow;
    name: @tr("Select {}", root.workout.name);
    height: root.narrow ? 64px : 76px;
    chosen => { Actions.select-workout(root.workout.id); }
    HorizontalLayout {
        padding: root.narrow ? 8px : 12px; padding-left: root.narrow ? 10px : 12px; padding-right: 12px; spacing: root.narrow ? 12px : 16px;
        Rectangle {
            width: root.narrow ? 84px : 132px; border-radius: 6px; background: Theme.sunken.with-alpha(0.5);
            WorkoutChart { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px; steps: root.workout.profile; }
        }
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1; min-width: 0px;
            HorizontalLayout {
                spacing: 8px; alignment: start;
                Text { text: root.workout.name; color: Theme.ink; font-size: root.narrow ? 15px : 16px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                if root.workout.built-in: BuiltInBadge { y: (parent.height - self.height) / 2; }
            }
            Text { text: root.narrow ? root.workout.meta : root.workout.summary; color: Theme.muted; font-size: 13px; overflow: elide; }
        }
        if !root.narrow: Text { text: root.workout.meta; color: Theme.ink; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; min-width: 120px; }
        if root.live && !root.narrow: ActionButton {
            y: (parent.height - self.height) / 2;
            label: "↗"; quiet: true; compact: true; min-width: 36px;
            accessible-label: @tr("Open {} in browser", root.workout.name);
            activated => { Actions.open-workout(root.workout.id); }
        }
        Text { text: "›"; color: Theme.faint; font-size: 22px; vertical-alignment: center; }
    }
}

// The free ride as a row of the list: a session like the others, without a plan.
component FreeRideRow inherits RowSurface {
    in property <bool> narrow;
    name: @tr("Start a free ride with the connected sensors");
    enabled: State.can-open-ride;
    height: root.narrow ? 56px : 64px;
    background: Theme.sunken.with-alpha(0.5);
    chosen => { Actions.start-free-ride(); }
    HorizontalLayout {
        padding-left: 16px; padding-right: 12px; spacing: 14px;
        Text { text: "∞"; color: State.can-open-ride ? Theme.primary : Theme.faint; font-size: 24px; vertical-alignment: center; }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
            Text { text: @tr("Free ride"); color: State.can-open-ride ? Theme.ink : Theme.faint; font-size: 15px; font-weight: 600; }
            Text { text: State.any-sensor ? @tr("No targets. Power, heart rate and cadence from the paired sensors.") : @tr("Needs a paired sensor."); color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        Text { text: "›"; color: Theme.faint; font-size: 22px; vertical-alignment: center; }
    }
}

component FlowChoose inherits Rectangle {
    in property <bool> narrow;
    // 0 everything, 1 personal, 2 built-in.
    property <int> category: 0;
    property <bool> has-built-ins: State.workouts-total > State.workouts-personal;
    property <bool> show-personal: root.category != 2;
    property <bool> show-built-ins: root.category != 1 && has-built-ins;
    property <bool> nothing: State.workouts-total == 0 || (State.workouts.length == 0 && State.built-ins.length == 0);
    Page { max: 1120px; VerticalLayout {
        padding-top: root.narrow ? 16px : 28px; padding-bottom: 16px; spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px; horizontal-stretch: 1; min-width: 0px;
                Text { text: @tr("Workouts"); color: Theme.ink; font-size: root.narrow ? 24px : 30px; font-weight: 700; }
                if !root.narrow: Text { text: @tr("Pick one to ride it step by step. Create and edit on the website."); color: Theme.muted; font-size: 13px; wrap: word-wrap; }
            }
            ActionButton {
                y: (parent.height - self.height) / 2;
                label: !State.workouts-loading ? @tr("Refresh") : State.workouts-total > 0 ? @tr("Refreshing…") : @tr("Loading…"); quiet: true; compact: true;
                enabled: !State.workouts-loading && State.workouts-error != 1;
                activated => { Actions.refresh-workouts(); }
            }
            if State.session-live: ActionButton { y: (parent.height - self.height) / 2; label: root.narrow ? @tr("New") : @tr("New workout in browser"); quiet: true; compact: true; activated => { Actions.create-workout(); } }
        }
        LibraryNotices { }
        // The toolbar: search, the filters as chips, the match count while filtering.
        if State.workouts-total > 0: HorizontalLayout {
            spacing: 10px;
            TextField {
                width: root.narrow ? 160px : 300px; height: 36px;
                label: @tr("Search workouts by name");
                text <=> State.workout-query;
                placeholder: @tr("Search");
                edited => { Actions.filter-workouts(State.workout-query); }
            }
            FilterChip { y: (parent.height - self.height) / 2; label: @tr("All"); count: State.workouts-total; active: root.category == 0; activated => { root.category = 0; } }
            if !root.narrow || State.workouts-personal > 0: FilterChip { y: (parent.height - self.height) / 2; label: @tr("Personal"); count: State.workouts-personal; active: root.category == 1; activated => { root.category = 1; } }
            if has-built-ins: FilterChip { y: (parent.height - self.height) / 2; label: @tr("Built-in"); count: State.workouts-total - State.workouts-personal; active: root.category == 2; activated => { root.category = 2; } }
            if State.workouts-filtering && !root.narrow: Text { text: @tr("{} of {} match", State.workouts.length + State.built-ins.length, State.workouts-total); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
            if State.workouts-filtering: ActionButton { y: (parent.height - self.height) / 2; label: @tr("Clear"); quiet: true; compact: true; accessible-label: @tr("Clear search"); activated => { State.workout-query = ""; Actions.filter-workouts(""); } }
            Rectangle { horizontal-stretch: 1; min-width: 0px; }
        }
        VerticalLayout {
            vertical-stretch: 1; spacing: 8px;
            // The free ride needs no library: it stays above the board while the list loads,
            // fails, is empty or matches nothing, and leaves only with the Personal and Built-in filters.
            if root.category == 0: FreeRideRow { narrow: root.narrow; }
            Rectangle {
                vertical-stretch: 1;
                if nothing: LibraryState { }
                // The board: each section under a small-caps heading.
                if !nothing: ScrollView {
                    VerticalLayout {
                        spacing: 8px; alignment: start; padding-right: 4px;
                        if show-personal: SectionLabel { text: @tr("PERSONAL"); count: State.workouts-personal; }
                        if show-personal: VerticalLayout { spacing: 8px; for workout in State.workouts: LibraryRow { workout: workout; live: State.session-live; narrow: root.narrow; } }
                        if show-personal && State.workouts.length == 0: Text {
                            text: State.workouts-filtering ? @tr("No personal workout matches this search.") : @tr("No personal workouts yet. Create one on the website; it appears here after a refresh.");
                            color: Theme.faint; font-size: 13px; wrap: word-wrap;
                        }
                        if show-built-ins: SectionLabel { text: @tr("BUILT-IN"); count: State.workouts-total - State.workouts-personal; note: root.narrow ? "" : @tr("FTP assessments, ready to ride."); }
                        if show-built-ins: VerticalLayout { spacing: 8px; for workout in State.built-ins: LibraryRow { workout: workout; live: State.session-live; narrow: root.narrow; } }
                        if show-built-ins && State.built-ins.length == 0: Text { text: @tr("No built-in workout matches this search."); color: Theme.faint; font-size: 13px; wrap: word-wrap; }
                    }
                }
            }
        }
    } }
}

// The ride cannot start without a sensor: the reason is the first thing on the page, and
// the action stays in view at the bottom whatever the length of the step list.
component NoSensorNotice inherits Rectangle {
    in property <bool> narrow;
    border-radius: 8px; background: Theme.warn.with-alpha(0.12); border-width: 1px; border-color: Theme.warn.with-alpha(0.45);
    height: layout.preferred-height;
    layout := HorizontalLayout {
        padding: 12px; padding-left: 14px; spacing: 12px;
        Rectangle { width: 3px; border-radius: 2px; background: Theme.warn; }
        VerticalLayout {
            spacing: 3px; horizontal-stretch: 1; min-width: 0px; alignment: center;
            Text { text: @tr("No trainer or heart-rate sensor is connected, so the ride cannot start."); color: Theme.warn; font-size: 14px; font-weight: 600; wrap: word-wrap; }
            Text { text: @tr("Pedal a few strokes to wake the trainer, then pair it on the Devices step. A strap alone is enough to record."); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; ActionButton { label: root.narrow ? @tr("Devices") : @tr("Go to Devices"); compact: true; activated => { Actions.navigate(0); } } }
    }
}

component FlowReady inherits Rectangle {
    in property <bool> narrow;
    // Two columns (the steps beside the sensor check) need a wide window; anything less
    // stacks, and a column too narrow for three captions lists the readings as rows.
    property <bool> two-columns: root.width >= 1000px;
    Page { max: 1000px; VerticalLayout {
        padding: 0px; spacing: 0px;
        ScrollView { vertical-stretch: 1; VerticalLayout {
            padding-top: 20px; padding-bottom: 20px; padding-right: 4px; spacing: 16px; alignment: start;
            HorizontalLayout {
                spacing: 12px;
                ActionButton { label: @tr("‹ Workouts"); quiet: true; compact: true; activated => { Actions.close-training(); } }
                Rectangle { horizontal-stretch: 1; }
                if State.ride-has-workout && State.session-live: ActionButton { label: @tr("Open in browser"); quiet: true; compact: true; activated => { Actions.open-workout(State.selected-workout.id); } }
            }
            HorizontalLayout {
                spacing: 10px; alignment: start;
                Text { text: Copy.ride-title(); color: Theme.ink; font-size: root.narrow ? 26px : 34px; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
                if State.ride-built-in: Rectangle { y: 10px; width: 60px; height: 20px; border-radius: 4px; background: Theme.primary.with-alpha(0.12); Text { text: @tr("Built-in"); color: Theme.primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
            }
            if State.ride-meta != "" || State.ride-summary != "": Text { text: State.ride-meta + (State.ride-meta != "" && State.ride-summary != "" ? "  ·  " : "") + State.ride-summary; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
            if !State.any-sensor: NoSensorNotice { narrow: root.narrow; }
            if State.ride-notice == 2: Notice { text: @tr("The recording could not be started."); detail: State.ride-notice-detail; }
            if State.ride-has-workout: Rectangle {
                height: root.narrow ? 170px : 220px; border-radius: 12px; background: Theme.card; border-width: 1px; border-color: Theme.border;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Caption { text: State.ride-guided ? @tr("{n} timed step" | "{n} timed steps" % State.ride-plan-steps) + " · " + State.ride-plan-total : @tr("REFERENCE ONLY"); }
                    WorkoutChart { vertical-stretch: 1; steps: State.ride-guided ? State.ride-plan : State.ride-profile; }
                }
            }
            if two-columns: HorizontalLayout {
                spacing: 16px; alignment: start;
                // The step list stops at a fixed height and scrolls inside, so a long test
                // never pushes the sensor check and the notice down the page.
                if State.ride-guided: Rectangle {
                    width: 340px; border-radius: 12px; background: Theme.card; border-width: 1px; border-color: Theme.border;
                    height: min(360px, 52px + State.ride-steps.length * 42px);
                    clip: true;
                    VerticalLayout {
                        padding: 10px; spacing: 6px;
                        Caption { text: @tr("STEPS"); x: 10px; }
                        ScrollView { vertical-stretch: 1; VerticalLayout { alignment: start; padding-right: 4px; StepList { compact: true; } } }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0px; spacing: 16px; alignment: start;
                    SensorCheck { rows: true; }
                    Notice { info: true; text: Copy.ready-notice(); }
                }
            }
            if !two-columns: SensorCheck { stacked: true; rows: root.width < 640px; }
            if !two-columns && State.ride-guided: Rectangle {
                border-radius: 12px; background: Theme.card; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 10px; spacing: 6px; alignment: start; Caption { text: @tr("STEPS"); x: 10px; } StepList { compact: true; } }
            }
            if !two-columns: Notice { info: true; text: Copy.ready-notice(); }
        } }
        Rectangle { height: 1px; background: Theme.border; }
        // Pinned: what stands between the rider and the ride, the ERG choice the ride starts
        // with, and the one action. Each control sits in a column that centers it, so
        // buttons of different heights align. Start pressed with a trainer gives way, in the
        // same place, to the wait for the first pedal stroke: the trainer's watts show as
        // they arrive, Start now skips the wait for a trainer that never reports, Cancel
        // stands it down, and the switch stays. No primary button while waiting.
        VerticalLayout {
            padding-top: 16px; padding-bottom: 16px; spacing: 10px;
            // Under the two-column width the bar has no room for the switch beside the
            // readings and the buttons: the switch and its line get a row of their own.
            if State.ride-guided && !root.two-columns: HorizontalLayout {
                spacing: 12px;
                ErgToggle { y: (parent.height - self.height) / 2; }
                ErgChoice { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 12px;
                // The column's minimum is the title's: on a wide bar the title keeps its
                // full width and the ERG line yields first; the lines under it elide.
                VerticalLayout {
                    spacing: 3px; alignment: center; horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        if State.ride-waiting: BreathingDot { y: (parent.height - self.height) / 2; }
                        Text {
                            text: State.ride-waiting ? @tr("Waiting for your first pedal stroke") : !State.any-sensor ? @tr("No sensor connected.") : State.signing-in ? @tr("Waiting for the browser…") : @tr("Sensors ready.");
                            color: !State.any-sensor ? Theme.warn : Theme.ink; font-size: 15px; font-weight: 600; overflow: elide; horizontal-stretch: 1;
                            min-width: root.narrow ? 0px : self.preferred-width;
                        }
                    }
                    // The watts as they arrive, or their absence: whether Start now is the way.
                    if State.ride-waiting: Text {
                        text: State.ride-power-live ? @tr("{} reports {} W", State.trainer-name, State.ride-power) : @tr("No reading from {} yet", State.trainer-name);
                        color: Theme.muted; font-size: 12px; overflow: elide; min-width: 0px;
                    }
                    if !State.ride-waiting && !root.narrow: Text {
                        text: !State.any-sensor ? @tr("Pair a trainer or a heart-rate strap on the Devices step; Start unlocks as soon as one delivers.") : State.trainer-connected ? @tr("{} paired. Recording starts at your first pedal stroke.", State.trainer-name) : @tr("Heart rate only: power and cadence stay empty.");
                        color: Theme.muted; font-size: 12px; overflow: elide; min-width: 0px;
                    }
                }
                if State.ride-guided && root.two-columns: VerticalLayout {
                    spacing: 3px; alignment: center; horizontal-stretch: 0;
                    // The switch keeps its own width; the block takes the line's.
                    HorizontalLayout { alignment: start; ErgToggle { } }
                    ErgChoice { max-width: 360px; }
                }
                if !State.any-sensor: VerticalLayout { alignment: center; ActionButton { label: @tr("Devices"); quiet: true; activated => { Actions.navigate(0); } } }
                if State.ride-waiting && !root.narrow: VerticalLayout {
                    alignment: center;
                    ActionButton { label: @tr("Cancel"); quiet: true; accessible-label: @tr("Cancel the start"); activated => { State.ride-waiting = false; } }
                }
                if State.ride-waiting && !root.narrow: VerticalLayout {
                    alignment: center;
                    ActionButton { label: @tr("Start now"); accessible-label: @tr("Start recording now, without waiting for power"); activated => { Actions.start-ride-now(); } }
                }
                if !State.ride-waiting: VerticalLayout {
                    alignment: center;
                    ActionButton {
                        label: @tr("Start the ride"); primary: true; large: !root.narrow; enabled: State.can-start; min-width: root.narrow ? 120px : 220px;
                        accessible-label: State.can-start ? @tr("Start the ride") : @tr("Start the ride (pair a sensor first)");
                        activated => { Actions.start-ride(); }
                    }
                }
            }
            // Narrow, the wait keeps the whole line and its two buttons sit under it.
            if State.ride-waiting && root.narrow: HorizontalLayout {
                spacing: 12px; alignment: end;
                ActionButton { label: @tr("Cancel"); quiet: true; compact: true; accessible-label: @tr("Cancel the start"); activated => { State.ride-waiting = false; } }
                ActionButton { label: @tr("Start now"); compact: true; accessible-label: @tr("Start recording now, without waiting for power"); activated => { Actions.start-ride-now(); } }
            }
        }
    } }
}

// "What am I doing right now": the target, how far off, how long is left, what comes next.
component TargetPanel inherits Rectangle {
    // The panel's scale: 1 is the default window, the wide ride raises it with the gauge.
    in property <float> unit: 1;
    property <bool> over: State.ride-workout-complete;
    property <color> tone: State.ride-target != "" ? Theme.zone-color(State.ride-target-zone) : Theme.faint;
    border-radius: 16px * root.unit; background: Theme.card.with-alpha(0.85); border-width: 1px; border-color: Theme.border;
    height: content.preferred-height;
    content := VerticalLayout {
        padding: 18px * root.unit; spacing: 8px * root.unit; alignment: start;
        HorizontalLayout {
            spacing: 8px * root.unit;
            Caption { text: @tr("TARGET"); font-size: 11px * root.unit; }
            Rectangle { horizontal-stretch: 1; }
            if State.ride-step-number > 0 && !over: Caption { text: @tr("STEP {} OF {}", State.ride-step-number, State.ride-plan-steps); font-size: 11px * root.unit; horizontal-alignment: right; }
        }
        if over: Text { text: @tr("Workout complete"); color: Theme.primary; font-size: 24px * root.unit; font-weight: 700; wrap: word-wrap; }
        if over: Text { text: @tr("Keep riding freely, or finish the ride."); color: Theme.muted; font-size: 12px * root.unit; wrap: word-wrap; }
        if !over: HorizontalLayout {
            spacing: 6px * root.unit; alignment: start;
            Text { text: State.ride-target != "" ? State.ride-target : "—"; color: tone; font-size: 56px * root.unit; font-weight: 700; vertical-alignment: bottom; font-family: "DejaVu Sans Mono"; }
            VerticalLayout { alignment: end; padding-bottom: 10px * root.unit; Caption { text: State.ride-target != "" ? @tr("W") : @tr("FREE"); font-size: 13px * root.unit; } }
        }
        if !over: Text {
            text: Copy.step-words(State.ride-step-duration, State.ride-step-target) + (State.ride-step-role != 0 ? " · " + Copy.role-name(State.ride-step-role) : "");
            color: Theme.muted; font-size: 13px * root.unit; overflow: elide;
        }
        if !over: HorizontalLayout {
            spacing: 6px * root.unit; alignment: start;
            Text {
                text: State.ride-step-remaining;
                color: State.ride-step-remaining-seconds > 0 && State.ride-step-remaining-seconds <= 5 ? Theme.primary : Theme.ink;
                font-size: 32px * root.unit; font-weight: 700; vertical-alignment: bottom; font-family: "DejaVu Sans Mono";
            }
            VerticalLayout { alignment: end; padding-bottom: 7px * root.unit; Caption { text: @tr("LEFT"); font-size: 11px * root.unit; } }
        }
        if !over: Rectangle {
            height: 6px * root.unit; border-radius: 3px * root.unit; background: Theme.sunken;
            Rectangle { x: 0px; width: parent.width * min(1, max(0, State.ride-step-progress)); height: parent.height; border-radius: 3px * root.unit; background: State.ride-target != "" ? tone : Theme.muted; }
        }
        if !over: HorizontalLayout {
            spacing: 6px * root.unit; alignment: start; padding-top: 4px * root.unit;
            Caption { text: State.ride-next-duration != "" ? @tr("NEXT") : @tr("LAST STEP"); font-size: 11px * root.unit; vertical-alignment: center; }
            if State.ride-next-duration != "": ZoneDot { y: (parent.height - self.height) / 2; width: 8px * root.unit; height: 8px * root.unit; border-radius: 4px * root.unit; zone: State.ride-next-target != "" ? State.ride-next-zone : 0; }
            if State.ride-next-duration != "": Text { text: Copy.step-words(State.ride-next-duration, State.ride-next-target); color: Theme.ink; font-size: 13px * root.unit; font-weight: 600; vertical-alignment: center; overflow: elide; }
        }
        if !over && (State.ride-step-cadence != "" || State.ride-step-note != ""): HorizontalLayout {
            spacing: 8px * root.unit; alignment: start;
            if State.ride-step-cadence != "": CadenceCue { y: (parent.height - self.height) / 2; unit: root.unit; }
            if State.ride-step-note != "": Text { text: State.ride-step-note; color: Theme.ink; font-size: 13px * root.unit; overflow: elide; vertical-alignment: center; min-width: 0px; }
        }
    }
}

// A callout for what matters this second: one line in a tinted pill. The narrow ride
// stacks it under the gauge; the wide ride lays it over the gauge's open bottom, so it
// appears without moving anything, at `fitted-width`.
component GaugeCallout inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.primary;
    in property <float> unit: 1;
    out property <length> fitted-width: label.preferred-width + 32px * root.unit;
    height: 30px * root.unit; border-radius: self.height / 2; background: root.tone.with-alpha(0.16);
    label := Text {
        x: 12px * root.unit; width: parent.width - 24px * root.unit;
        text: root.text; color: root.tone; font-size: 13px * root.unit; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
}

// The gauge with the live power in it: the zone's color fills the arc, the target sits as
// a tick with its band, so holding the number becomes a matter of keeping the arc in the band.
component PowerGauge inherits Gauge {
    in property <length> size: 300px;
    width: root.size; height: root.size;
    level: State.ride-power-level;
    target: State.ride-target-level;
    band: State.ride-band-level;
    tone: State.ride-power-zone == 0 ? Theme.primary : Theme.zone-color(State.ride-power-zone);
    thickness: root.size * 0.06;
    VerticalLayout {
        alignment: center; spacing: 0px;
        Text { text: State.ride-power-live ? State.ride-power : "—"; color: State.ride-power-live ? Theme.ink : Theme.faint; font-size: root.size * 0.26; font-weight: 700; horizontal-alignment: center; font-family: "DejaVu Sans Mono"; }
        Caption { text: @tr("WATTS"); horizontal-alignment: center; font-size: root.size * 0.045; }
        if State.ride-delta != "": Text { text: State.ride-delta; color: State.ride-delta-state == 1 ? Theme.good : State.ride-delta-state == 2 ? Theme.warn : Theme.heart; font-size: root.size * 0.08; font-weight: 600; horizontal-alignment: center; font-family: "DejaVu Sans Mono"; }
    }
}

// The guided ride's controls: resistance, intensity, skip. Tests keep their protocol.
component HudControls inherits VerticalLayout {
    in property <bool> wrap;
    // The ERG line's text size: what the trainer is doing has to read from the bike, so
    // the wide ride raises it, within the row the switch sets the height of.
    in property <length> status-size: 12px;
    // Compact buttons, as the narrow ride and the default window use; a large window gets full ones.
    in property <bool> compact: true;
    spacing: 8px;
    if !root.wrap: HorizontalLayout {
        spacing: 12px;
        if State.erg-toggle-shown: ErgToggle { y: (parent.height - self.height) / 2; }
        ErgStatus { horizontal-stretch: 1; font-size: root.status-size; }
        if State.step-controls-shown && !State.ride-test: IntensityControl { size: root.status-size + 1px; compact: root.compact; }
        if State.step-controls-shown && !State.ride-test: SkipButton { y: (parent.height - self.height) / 2; compact: root.compact; }
    }
    if root.wrap: HorizontalLayout {
        spacing: 12px;
        if State.erg-toggle-shown: ErgToggle { y: (parent.height - self.height) / 2; }
        ErgStatus { horizontal-stretch: 1; }
    }
    if root.wrap && State.step-controls-shown && !State.ride-test: HorizontalLayout {
        spacing: 12px;
        IntensityControl { }
        Rectangle { horizontal-stretch: 1; }
        SkipButton { y: (parent.height - self.height) / 2; }
    }
}

component FlowHud inherits Rectangle {
    in property <bool> narrow;
    // The window height, from the design root: the stage sizes the gauge from it rather
    // than from its own height, which the layout derives from the gauge.
    in property <length> stage: 800px;
    property <bool> short: root.stage < 720px;
    property <bool> guided: State.ride-guided;
    property <bool> soon: State.ride-active && guided && !State.ride-workout-complete && State.ride-step-remaining-seconds > 0 && State.ride-step-remaining-seconds <= 5;
    // The ride's own pause, after five seconds at zero watts or thirty without any reading:
    // the next pedal stroke ends it.
    property <bool> auto-paused: State.ride-phase == 2 && State.ride-auto-paused;
    // The ride is read from the bike, metres from the screen, so the wide stage grows with
    // the window instead of sitting as an island in it. Every size here derives from the
    // window alone (a size fed back from the layout would loop):
    // - `grow` is the window against the default 1180×800; width and height both count,
    //   so a wide and short window keeps its chrome modest and its gauge round.
    // - `chrome` scales the paddings, the plan and the chart at half that rate: they
    //   matter less from afar than the figures.
    // - `gauge` is the height the bar, the controls, the plan and the chart leave, within
    //   the width the three columns need.
    // - `unit` scales every figure beside the gauge in step with it, so the hierarchy
    //   holds at any size; `text` is a gentler scale for the words around them.
    property <float> grow: max(1, min(3, min(root.width / 1180px, root.stage / 800px)));
    property <float> chrome: 1 + (grow - 1) * 0.5;
    property <length> bar-height: 60px * grow;
    property <length> stage-pad: 20px * chrome;
    property <length> plan-height: 58px * chrome;
    property <length> chart-height: (guided ? 130px : 180px) * chrome;
    property <bool> chart-shown: !root.short || !guided;
    // The desk controls (Devices, intensity, skip) keep their compact size until the
    // window is large enough for full buttons to sit in proportion with the rest.
    property <bool> desk-compact: root.grow < 1.5;
    // The guided ride's controls row (the switch or the full buttons set its height), with
    // the padding under it; the notices give way elsewhere.
    property <length> controls-height: guided ? (root.desk-compact ? 48px : 56px) : 0px;
    property <length> gauge: max(220px, min(
        root.stage - root.bar-height - 2 * root.stage-pad - root.controls-height - (guided ? root.plan-height : 0px) - (root.chart-shown ? root.chart-height : 0px),
        (root.width - 2 * root.stage-pad - (guided ? 2 : 1) * root.stage-pad) * 360 / (guided ? 850 : 550)));
    property <float> unit: max(1, root.gauge / 360px);
    property <float> text: (root.unit + 1) / 2;
    VerticalLayout {
        // The slim bar: the clock, the ride, a way back to Devices, the two ride controls. No app chrome while riding.
        Rectangle {
            height: root.bar-height; background: Theme.card.with-alpha(0.6);
            HorizontalLayout {
                padding-left: 20px * root.chrome; padding-right: 16px * root.chrome; spacing: 12px * root.chrome;
                Rectangle { y: (parent.height - self.height) / 2; width: 10px * root.chrome; height: self.width; border-radius: self.width / 2; background: State.ride-phase == 1 ? Theme.heart : Theme.pause; }
                Text { text: State.ride-elapsed; color: Theme.ink; font-size: min(26px * root.unit, root.bar-height * 0.72); font-weight: 700; vertical-alignment: center; font-family: "DejaVu Sans Mono"; }
                if !root.narrow: Text { text: State.ride-phase == 2 ? (State.ride-auto-paused ? @tr("Auto-paused") : @tr("Paused")) : @tr("Recording"); color: Theme.muted; font-size: 13px * root.text; vertical-alignment: center; }
                Rectangle { width: 1px; height: 24px * root.chrome; y: (parent.height - self.height) / 2; background: Theme.border; }
                Text { text: Copy.ride-title(); color: Theme.ink; font-size: 15px * root.text; font-weight: 600; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; }
                if guided && !root.narrow: Caption { text: State.ride-workout-complete ? @tr("DONE") : @tr("{} LEFT", State.ride-workout-remaining); font-size: min(11px * root.unit, root.bar-height * 0.4); vertical-alignment: center; }
                // The one way back to the sensors: the notices send a rider here when one drops.
                ActionButton { y: (parent.height - self.height) / 2; label: @tr("Devices"); quiet: true; compact: root.desk-compact; accessible-label: @tr("Devices, to reconnect a sensor"); activated => { Actions.navigate(0); } }
                if State.ride-phase == 1: GlyphButton { y: (parent.height - self.height) / 2; size: 42px * root.chrome; glyph: "pause"; label: @tr("Pause"); tone: Theme.pause; activated => { Actions.pause-ride(); } }
                if State.ride-phase == 2: GlyphButton { y: (parent.height - self.height) / 2; size: 42px * root.chrome; glyph: "play"; label: @tr("Resume"); filled: true; activated => { Actions.resume-ride(); } }
                GlyphButton { y: (parent.height - self.height) / 2; size: 42px * root.chrome; glyph: "stop"; label: @tr("Finish ride"); tone: Theme.heart; activated => { Actions.finish-ride(); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // The stage: the target beside the gauge beside the heart and the legs.
        if !root.narrow: HorizontalLayout {
            vertical-stretch: 1; padding: root.stage-pad; spacing: root.stage-pad; alignment: center;
            // A row is only as tall as its shortest column allows, so every column here
            // carries an unbounded spacer: the stage then takes the whole window height.
            // The side columns take a share of the width beyond their figures' own, so a
            // wide window fills with the ride rather than with margins.
            if guided: VerticalLayout {
                width: min(360px * root.unit, root.width * 0.28); alignment: center;
                Rectangle { vertical-stretch: 1; }
                TargetPanel { unit: root.unit; }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle { vertical-stretch: 1; }
                // The gauge's box asks for the gauge's height and gives some up when a
                // notice below needs it, so the plan and the chart never leave the window;
                // the gauge stays round in whatever is left. The callout lies over the
                // arc's open bottom, so it comes and goes without moving the gauge; a long
                // line (the French auto-pause) may run into the gaps beside the box.
                Rectangle {
                    width: root.gauge; preferred-height: root.gauge; min-height: 0px; vertical-stretch: 0;
                    PowerGauge { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; size: min(parent.width, parent.height); }
                    if root.soon && !root.auto-paused: GaugeCallout {
                        x: (parent.width - self.width) / 2; y: parent.height - self.height; width: min(parent.width + 2 * root.stage-pad, self.fitted-width); unit: root.unit;
                        text: @tr("Next: {}", Copy.step-words(State.ride-next-duration, State.ride-next-target));
                    }
                    if root.auto-paused: GaugeCallout {
                        x: (parent.width - self.width) / 2; y: parent.height - self.height; width: min(parent.width + 2 * root.stage-pad, self.fitted-width); unit: root.unit;
                        text: @tr("Auto-paused · pedal to resume"); tone: Theme.pause;
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                width: min(250px * root.unit, root.width * 0.22); alignment: center; spacing: 12px * root.unit;
                Rectangle { vertical-stretch: 1; }
                MetricTile { label: @tr("HEART RATE"); value: State.ride-hr; unit: @tr("bpm"); live: State.ride-hr-live; tone: Theme.heart; size: 40px * root.unit; scale: root.unit; }
                MetricTile { label: @tr("CADENCE"); value: State.ride-cadence; unit: @tr("rpm"); live: State.ride-cadence-live; tone: Theme.cadence; size: 40px * root.unit; scale: root.unit; }
                Rectangle { vertical-stretch: 1; }
            }
        }
        if root.narrow: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px; spacing: 12px; alignment: start;
                HorizontalLayout { alignment: center; PowerGauge { size: 200px; } }
                if root.soon && !root.auto-paused: GaugeCallout { text: @tr("Next: {}", Copy.step-words(State.ride-next-duration, State.ride-next-target)); }
                if root.auto-paused: GaugeCallout { text: @tr("Auto-paused · pedal to resume"); tone: Theme.pause; }
                HorizontalLayout {
                    spacing: 12px;
                    MetricTile { label: @tr("HEART RATE"); value: State.ride-hr; unit: @tr("bpm"); live: State.ride-hr-live; tone: Theme.heart; size: 26px; }
                    MetricTile { label: @tr("CADENCE"); value: State.ride-cadence; unit: @tr("rpm"); live: State.ride-cadence-live; tone: Theme.cadence; size: 26px; }
                }
                if guided: TargetPanel { }
                if guided: HudControls { wrap: true; }
                RideNotices { }
                if guided: Rectangle { height: 44px; border-radius: 8px; background: Theme.card; border-width: 1px; border-color: Theme.border; PlanBar { x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px; steps: State.ride-plan; progress: State.ride-workout-progress; step-start: State.ride-step-start; step-share: State.ride-step-share; } }
                ChartPanel { height: 150px; title: @tr("LAST 10 MINUTES"); }
            }
        }
        if !root.narrow && (guided || State.ride-notice != 0 || State.ride-phase == 2 || !State.any-sensor): VerticalLayout {
            padding-left: root.stage-pad; padding-right: root.stage-pad; padding-bottom: 12px; spacing: 10px;
            if guided: HudControls { wrap: false; status-size: min(28px, 12px * root.unit); compact: root.desk-compact; }
            RideNotices { size: 13px * root.text; }
        }
        // The plan across the bottom, then the last ten minutes. Short windows keep the plan.
        if !root.narrow && guided: Rectangle {
            height: root.plan-height; background: Theme.card.with-alpha(0.6);
            Rectangle { y: 0px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding: 8px * root.chrome; padding-left: root.stage-pad; padding-right: root.stage-pad; spacing: 14px * root.chrome;
                Caption { text: @tr("PLAN"); font-size: 11px * root.text; vertical-alignment: center; }
                PlanBar { horizontal-stretch: 1; steps: State.ride-plan; progress: State.ride-workout-progress; step-start: State.ride-step-start; step-share: State.ride-step-share; }
                Caption { text: State.ride-plan-total; font-size: 11px * root.text; vertical-alignment: center; }
            }
        }
        if !root.narrow && root.chart-shown: Rectangle {
            height: root.chart-height; background: Theme.card.with-alpha(0.4);
            Rectangle { y: 0px; height: 1px; background: Theme.border; }
            ChartPanel { x: root.stage-pad; y: 8px * root.chrome; width: parent.width - 2 * root.stage-pad; height: parent.height - 16px * root.chrome; framed: false; caption-size: 11px * root.text; title: @tr("LAST 10 MINUTES"); }
        }
    }
}

component FlowSummary inherits Rectangle {
    in property <bool> narrow;
    Page { max: 960px; ScrollView { VerticalLayout {
        padding-top: 24px; padding-bottom: 24px; padding-right: 4px; spacing: 16px; alignment: start;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px; horizontal-stretch: 1; min-width: 0px;
                Caption { text: @tr("RIDE COMPLETE"); color: Theme.primary; }
                HorizontalLayout {
                    spacing: 10px; alignment: start;
                    Text { text: Copy.ride-title(); color: Theme.ink; font-size: root.narrow ? 24px : 30px; font-weight: 700; overflow: elide; min-width: 0px; }
                }
            }
            Text { text: State.ride-elapsed; color: Theme.ink; font-size: root.narrow ? 28px : 36px; font-weight: 700; vertical-alignment: center; font-family: "DejaVu Sans Mono"; }
        }
        SaveStatus { }
        SummaryStats { }
        ChartPanel { height: 200px; title: @tr("WHOLE RIDE"); }
        if State.ride-saved: UploadCard { stacked: root.narrow; }
        if State.ride-saved: FolderRow { }
        if State.ride-saved: HorizontalLayout {
            spacing: 12px; alignment: end;
            ActionButton { label: @tr("Done"); primary: true; enabled: !State.ride-uploading; activated => { Actions.close-training(); } }
        }
    } } }
}

export component DesignFlow inherits Rectangle {
    property <bool> narrow: root.width < 760px;
    property <bool> immersive: State.logged-in && State.screen == 2 && State.ride-active;
    VerticalLayout {
        padding: 0px; spacing: 0px;
        if !immersive: FlowHeader { narrow: root.narrow; compact: root.width < 940px; }
        if !State.logged-in: FlowLogin { narrow: root.narrow; vertical-stretch: 1; }
        if State.logged-in && State.screen == 0: FlowPair { narrow: root.narrow; vertical-stretch: 1; }
        if State.logged-in && State.screen == 1: FlowChoose { narrow: root.narrow; vertical-stretch: 1; }
        if State.logged-in && State.screen == 2 && State.ride-phase == 0: FlowReady { narrow: root.narrow; vertical-stretch: 1; }
        if immersive: FlowHud { narrow: root.narrow; stage: root.height; vertical-stretch: 1; }
        if State.logged-in && State.screen == 2 && State.ride-phase == 3: FlowSummary { narrow: root.narrow; vertical-stretch: 1; }
    }
}
